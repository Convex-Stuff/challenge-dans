# Local development: Postgres runs in Docker (see docker-compose.yml),
# the Next.js dev server runs on the host via `bun run dev`.
POSTGRES_USER=dans
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dans
POSTGRES_PORT=5432

DATABASE_URL="postgresql://dans:change_me@localhost:5432/dans?schema=public"

# Auth.js
# Generate a new one with: openssl rand -base64 32
AUTH_SECRET=""

# osu! OAuth application credentials.
# Register an app at https://osu.ppy.sh/home/account/edit#new-oauth-application
# and set the callback URL to <your-origin>/api/auth/callback/osu
AUTH_OSU_ID=""
AUTH_OSU_SECRET=""

# Production only: public origin of the deployment, https://dans.convex.coffee
# Must match the callback URL registered on the osu! OAuth application.
AUTH_URL=""
